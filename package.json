{
  "name": "cadara",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "studio": "sanity dev",
    "studio:build": "sanity build dist/studio",
    "import:content": "sanity exec scripts/import-content.mjs --with-user-token",
    "import:preview": "node scripts/import-content.mjs --dry-run",
    "test": "node --test tests/*.test.mjs",
    "studio:deploy": "sanity deploy dist/studio --url cadara-content"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "cheerio": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.19.0",
    "styled-components": "^6.6.0"
  }
}
