{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/site",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/cases/offer",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/cases/:slug((?!work$)[a-z0-9-]+)",
      "destination": "/:slug",
      "permanent": true
    }
  ]
}
